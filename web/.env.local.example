# Variables del MODO LOCAL de desarrollo (PostgreSQL 16 directo + disco; sin Docker ni Supabase).
# Copia a .env.local para `npm run dev` a mano, o usa `scripts/dev-all.sh`, que ya exporta todo esto.
# Nada de este archivo sirve en produccion: con NODE_ENV=production las rutas /api/_local/* dan 404.
# Los secretos reales NUNCA van en archivos versionados (solo en .env.local, ignorado por git).

# ---- Interruptores del modo local ------------------------------------------------------------
# SUSAN_LOCAL lo lee el servidor; NEXT_PUBLIC_SUSAN_LOCAL lo necesita ademas el bundle del navegador
# (para que getBrowserBackend() use /api/_local/* en lugar de Supabase). Deben ir juntos.
SUSAN_LOCAL=1
NEXT_PUBLIC_SUSAN_LOCAL=1

# ---- Base de datos ---------------------------------------------------------------------------
# Cluster creado por scripts/db-up.sh (puerto 54329, autenticacion trust solo en 127.0.0.1).
LOCAL_DATABASE_URL=postgres://127.0.0.1:54329/susan

# Reloj de demostracion (opcional): fija app.fake_now en cada RPC. Solo surte efecto porque la BD
# local tiene app.allow_fake_clock='on'. La semilla es el lunes 14-sep-2026 (periodo 2026-2).
# LOCAL_FAKE_NOW=2026-09-14 07:12:00-06

# ---- Sesion ----------------------------------------------------------------------------------
# Clave HMAC de la cookie 'susan_local_session' (8 h) y de las URL firmadas del storage local.
# Cualquier cadena larga; si cambia, las sesiones abiertas dejan de valer.
LOCAL_AUTH_SECRET=solo-desarrollo-cambia-esto
# Cuentas demo (@susan.local): admin@, tecnico@, docente1@..docente3@, e260001@..e260025@
# Contrasena de DESARROLLO de todas: demo1234

# ---- Storage en disco ------------------------------------------------------------------------
# Raiz de los objetos: <LOCAL_STORAGE_DIR>/<bucket>/<ruta>. Relativa = respecto a web/.
# El servicio de reconocimiento debe apuntar al MISMO arbol (STORAGE_DIR=<ruta absoluta de esta carpeta>).
LOCAL_STORAGE_DIR=.local/storage

# ---- Servicio de reconocimiento y tareas ------------------------------------------------------
RECOGNITION_SERVICE_URL=http://127.0.0.1:8000
RECOGNITION_SERVICE_API_KEY=dev-local-key
CRON_SECRET=dev-cron-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Varias instancias de `next dev` en paralelo ------------------------------------------------
# NEXT_DIST_DIR=.next-mi-nombre
