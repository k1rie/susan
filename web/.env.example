# ---------------------------------------------------------------- Supabase (producción / proyecto real)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=susan-private
# SOLO servidor. Nunca con prefijo NEXT_PUBLIC_. Salta RLS: vive únicamente en la capa de servicios.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Servicio de reconocimiento (FastAPI + FAISS)
RECOGNITION_SERVICE_URL=http://127.0.0.1:8000
RECOGNITION_SERVICE_API_KEY=cambia-esto

# Ruta del fotograma de las camaras IP (solo servidor): http://<direccion_ip><CAMERA_SNAPSHOT_PATH>
CAMERA_SNAPSHOT_PATH=/snapshot.jpg

# ---------------------------------------------------------------- Tareas programadas (/api/jobs/*)
CRON_SECRET=cambia-esto

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- Modo local (PostgreSQL 16 directo, sin Supabase ni Docker)
# SUSAN_LOCAL=1
# NEXT_PUBLIC_SUSAN_LOCAL=1
# LOCAL_DATABASE_URL=postgres://localhost:54329/susan
# LOCAL_STORAGE_DIR=.local/storage
# LOCAL_AUTH_SECRET=solo-desarrollo
# LOCAL_FAKE_NOW=2026-09-14 07:12:00-06   # reloj simulado de la demostracion (app.fake_now); 'off' = reloj real
# LOCAL_CLOCK_FILE=                       # archivo donde la tarjeta «Reloj de demostracion» guarda la hora (por omision: $SUSAN_LOCAL_DIR/run/fake_now)
