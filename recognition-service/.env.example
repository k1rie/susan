# Copie a .env y complete. NUNCA versione .env.
APP_ENV=development            # production exige API_KEY
API_KEY=                       # cabecera X-API-Key que enviara la app web
EMBEDDER=insightface           # insightface | fake
MODEL_DIR=.models              # donde se descargan los modelos de InsightFace
DIMENSION=512
STORAGE_BACKEND=local          # local | supabase
STORAGE_DIR=                     # solo STORAGE_BACKEND=local; por defecto <SUSAN_LOCAL_DIR>/storage (ver scripts/local-dir.sh)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BUCKET=susan-private
INDEX_BOOTSTRAP_VERSION=       # opcional: version a cargar al iniciar (p. ej. v003)
INDEX_ACCEPT_MODELS=           # opcional, SOLO pruebas locales: modelos de indice ajenos que se aceptan (p. ej. fake-hash)
ALLOW_PRIVATE_CAMERAS=0        # 1 en LAN: permite camaras en IP privadas/loopback
EMBEDDER_CONCURRENCY=2
# --- Plantilla de varias fotos (se promedian en UN vector); todas son opcionales y traen defecto ---
TEMPLATE_MIN_PHOTOS=3          # minimo de fotos aceptadas para registrar (3 <= min <= max <= 8; 8 es techo duro compartido con SQL y el proxy)
TEMPLATE_MAX_PHOTOS=8
TEMPLATE_OUTLIER_COSINE=0.35   # coseno MEDIO minimo de cada foto contra las demas al registrar; 0 apaga el descarte (calibracion)
TEMPLATE_BUILD_OUTLIER_COSINE= # umbral del constructor del indice (defecto min(0.25, TEMPLATE_OUTLIER_COSINE)); debe ser <= el de registro
TEMPLATE_LINK_COSINE=0.30      # segundo criterio: las fotos conservadas deben formar UN grupo (dos fotos se enlazan si su coseno >= este valor); detecta mezclas 3+3 de dos personas; 0 lo apaga. El constructor usa min(0.20, este)
TEMPLATE_MAX_YAW_RATIO=0.40    # razon de giro maxima en modo conjunto (0.15 ~ 15 grados, 0.40 ~ 36)
TEMPLATE_DUP_COSINE=0.97       # fotos con coseno >= este valor se consideran casi identicas (aviso DIVERSIDAD_BAJA)
TEMPLATE_MAX_TOTAL_BYTES=31457280  # tope de bytes de toda la peticion /v1/photo/check-set (30 MiB)

