# Copie a .env y complete. NUNCA versione .env.
APP_ENV=development            # production exige API_KEY
API_KEY=                       # cabecera X-API-Key que enviara la app web
EMBEDDER=insightface           # insightface | fake
MODEL_DIR=.models              # donde se descargan los modelos de InsightFace
DIMENSION=512
STORAGE_BACKEND=local          # local | supabase
STORAGE_DIR=                     # solo STORAGE_BACKEND=local; por defecto <SUSAN_LOCAL_DIR>/storage (ver scripts/local-dir.sh)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BUCKET=susan-private
INDEX_BOOTSTRAP_VERSION=       # opcional: version a cargar al iniciar (p. ej. v003)
ALLOW_PRIVATE_CAMERAS=0        # 1 en LAN: permite camaras en IP privadas/loopback
EMBEDDER_CONCURRENCY=2
